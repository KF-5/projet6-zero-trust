@model AccueilVM

<section class="accueil-intro">
    <p class="surtitre">Projet 6 · Architecture Zero Trust</p>
    <h1>Le laboratoire, commande par commande</h1>
    <p class="chapeau">
        Chaque commande des six rôles est rejouée sur le schéma : la machine concernée s'allume, les paquets suivent
        le vrai chemin (VLAN, NAT, pare-feu) et une règle décide s'ils passent.
        @Model.TotalEtapes étapes, @Model.TotalCommandes commandes.
    </p>
</section>

<section class="accueil-carte" aria-label="Carte de l'architecture, état A">
    <partial name="_Schema" model="Model.Schema" view-data='new ViewDataDictionary(ViewData) { ["Decor"] = true }' />
</section>

<section class="accueil-roles" aria-labelledby="titre-roles">
    <h2 id="titre-roles">Les six rôles</h2>
    <ul class="cartes-roles">
        @foreach (var r in Model.Roles)
        {
            <li class="carte-role" style="--role: var(@r.Couleur)">
                <div class="carte-entete">
                    <span class="carte-numero" aria-hidden="true">@r.Numero</span>
                    <h3><span class="visuellement-cache">Rôle @r.Numero : </span>@r.Titre</h3>
                </div>
                <p class="carte-mission">@r.Mission</p>
                <div class="avancement" role="img" aria-label="@r.NbFaites étape(s) faite(s) sur @r.NbEtapes">
                    <span class="avancement-barre" style="width:@r.Pourcentage%"></span>
                </div>
                <p class="carte-chiffres">
                    <span><strong>@r.NbFaites</strong>/@r.NbEtapes étapes faites</span>
                    <span><strong>@r.NbCommandes</strong> commandes</span>
                </p>
                @if (r.ProchaineEtape is not null)
                {
                    <p class="carte-suite"><span class="etiquette">À faire</span> @r.ProchaineEtape</p>
                }
            </li>
        }
    </ul>
    <p class="note-jalon">Les pages de chaque rôle et le lecteur de commandes arrivent au jalon 4.</p>
</section>
