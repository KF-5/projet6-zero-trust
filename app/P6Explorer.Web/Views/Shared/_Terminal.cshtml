@* Terminal rejoué : lecteur.js y tape la commande caractère par caractère, puis affiche la sortie attendue. *@
<section class="terminal" aria-label="Terminal rejoué">
    <header class="terminal-barre">
        <span class="terminal-points" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="terminal-titre" id="terminal-titre">terminal</span>
        <span class="terminal-compteur" id="terminal-compteur" aria-live="polite"></span>
    </header>
    <pre class="terminal-ecran" id="terminal-ecran" tabindex="0" aria-live="polite" aria-label="Commande et sortie"><span class="terminal-vide">Appuie sur ▶ (ou la barre d'espace) pour rejouer les commandes.</span></pre>
</section>
