# ids/threshold.config — blocage temporaire de la source (rate_filter)
# Après 20 correspondances de 9000002 en 5 s depuis une même source (S-01), ou 100 de 9000004 en 1 s (S-02),
# l'action devient « drop » pour les paquets de cette règle, pendant 20 s (timeout 20 < pause de 30 s entre exécutions).
# 9000002 et 9000004 sont en « noalert » : le blocage est silencieux, il se voit dans stats.log (compteur ips.blocked)
# et par l'échec de l'attaque ; l'alerte de détection vient de 9000001 (S-01) et 9000003 (S-02).
# Vérifié hors ligne le 24/11 (suricata --simulate-ips) : flood de 3000 SYN -> 2900 bloqués ; scan 1-1024 -> 1001 bloqués ;
# 120 SYN légitimes (1/s) -> 0 bloqué, 0 alerte.

# --- Phase de réglage (mode IDS, étapes 9 à 11) : ne rien bloquer ---
# rate_filter gen_id 1, sig_id 9000002, track by_src, count 20, seconds 5, new_action alert, timeout 20
# rate_filter gen_id 1, sig_id 9000004, track by_src, count 100, seconds 1, new_action alert, timeout 20

# --- Phase IPS (étape 12, campagne B) ---
rate_filter gen_id 1, sig_id 9000002, track by_src, count 20, seconds 5, new_action drop, timeout 20
rate_filter gen_id 1, sig_id 9000004, track by_src, count 100, seconds 1, new_action drop, timeout 20
